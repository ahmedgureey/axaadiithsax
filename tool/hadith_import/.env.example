# Import tool environment — copy to .env (git-ignored) or set in your shell.
# NEVER put these values in the Flutter app, in git, or in screenshots.

# Project URL of the TARGET database (use the dev project first).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Secret key (Project Settings → API Keys → secret, "sb_secret_…").
# Server-side only. It can insert 'imported' rows but cannot verify/publish.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
